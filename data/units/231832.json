d_at":"2026-08-12T22:24:04.000000Z","updated_at":"2026-08-12T22:24:04.000000Z"},{"id":5963958,"review":"شكراً لك","rental_id":231832,"created_at":"2026-08-12T22:24:13.000000Z","updated_at":"2026-08-12T22:24:13.000000Z"},{"id":6024710,"review":"Positive:\nComfortable and close to the airport and hospital\n\nNegative:\nClean Neighborhood and clean Building","rental_id":231832,"created_at":"2026-08-12T22:24:20.000000Z","updated_at":"2026-08-12T22:24:20.000000Z"}],"amenities":[]}